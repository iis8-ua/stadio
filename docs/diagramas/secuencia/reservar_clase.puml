@startuml
' === STADIO - Secuencia: Reservar clase ===
skinparam defaultFontName "Arial"

actor "Cliente" as Cliente
participant "Frontend SPA" as FE
participant "API Laravel" as API
participant "Servicio de Reservas" as SRV
database "MySQL" as DB

Cliente -> FE : Pulsa [RESERVAR] en una clase
FE -> API : POST /api/clases/{id}/reservas
API -> SRV : reservar(cliente, clase)
SRV -> DB : Consulta clase (capacidad, asistentes)
DB --> SRV : datos de la clase

alt Clase completa (asistentes == capacidad)
  SRV --> API : Error 409 "Clase completa"
  API --> FE : 409 + mensaje
  FE --> Cliente : Toast "Clase completa" (RF-28)
else Plazas disponibles
  SRV -> DB : ¿Reserva activa del cliente en esta clase?
  DB --> SRV : resultado
  alt Reserva duplicada
    SRV --> API : Error 409 "Ya tienes reservada esta clase"
    API --> FE : 409
    FE --> Cliente : Toast de error (RF-29)
  else Sin duplicado
    SRV -> DB : INSERT reserva (confirmada)
    DB --> SRV : ok
    SRV --> API : Reserva confirmada
    API --> FE : 201 + reserva
    FE --> Cliente : "Reserva confirmada" + badge
  end
end

@enduml