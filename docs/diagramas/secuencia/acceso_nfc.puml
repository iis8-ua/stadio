@startuml
' === STADIO - Secuencia: Acceso por torno con pulsera NFC ===
skinparam defaultFontName "Arial"

actor "Cliente" as Cliente
participant "Torno / Lector NFC" as TORNO
participant "API Laravel (receptor de eventos)" as API
participant "Servicio de Accesos" as ACC
database "MySQL" as DB
participant "Frontend SPA" as FE

Cliente -> TORNO : Pasa la pulsera NFC por el lector
TORNO -> API : Evento de paso (identificador_pulsera, dirección)
API -> ACC : registrarAcceso(uid, tipo)
ACC -> DB : Buscar usuario por identificador_pulsera (RF-50)
DB --> ACC : resultado

alt Usuario no encontrado o desactivado
  ACC --> API : Error (acceso denegado)
  API --> TORNO : Deniega el paso
else Usuario válido y activo
  DB --> ACC : usuario
  ACC -> DB : INSERT acceso (entrada o salida) (RF-49)
  DB --> ACC : ok
  ACC -> DB : Recalcula aforo (entradas - salidas) (RF-52)
  DB --> ACC : personas dentro, capacidad, %
  ACC --> API : Acceso registrado + aforo actual
  API --> TORNO : Permite el paso
  API --> FE : Evento en tiempo real (aforo / estado acceso)
  FE --> Cliente : Actualiza aforo y su historial
end

@enduml