@startuml
' === STADIO - Secuencia: Registro de un entrenamiento ===
skinparam defaultFontName "Arial"

actor "Cliente" as Cliente
participant "Frontend SPA" as FE
participant "API Laravel" as API
participant "Servicio de Entrenamientos" as SER
database "MySQL" as DB

Cliente -> FE : Pulsa [EMPEZAR ENTRENAMIENTO] (RF-39)
FE -> API : POST /api/entrenamientos (rutina)
API -> SER : crearEntrenamiento(cliente, rutina)
SER -> DB : INSERT entrenamiento (en curso)
DB --> SER : entrenamiento
SER --> API : 201
API --> FE : entrenamiento en curso

loop por cada serie del ejercicio (RF-40)
  Cliente -> FE : Introduce peso, reps, RIR, RPE, descanso, notas
  FE -> API : POST /api/entrenamientos/{id}/series
  API -> SER : registrarSerie(serie)
  SER -> DB : INSERT serie
  DB --> SER : ok
  SER --> API : 201
  API --> FE : serie registrada
  FE --> Cliente : "Serie registrada" + temporizador de descanso (RF-44)
end

Cliente -> FE : Pulsa [FINALIZAR ENTRENAMIENTO] (RF-41)
FE -> API : PATCH /api/entrenamientos/{id}/finalizar
API -> SER : finalizar(entrenamiento)
SER -> DB : SELECT series del entrenamiento
DB --> SER : series
SER -> SER : Calcular duración y volumen total
SER -> DB : UPDATE entrenamiento = completado + resumen
DB --> SER : ok
SER --> API : Resumen final
API --> FE : resumen (0 ejercicios, 0 series, duración, volumen)
FE --> Cliente : "¡Entrenamiento completado!" + resumen (RF-42)

@enduml